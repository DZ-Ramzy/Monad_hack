# Funded deployer / custodian / treasury key. Never commit the real .env.
DEPLOYER_PK=0x

# Optional: override the public RPC with a private one (Alchemy / QuickNode).
# Strongly recommended for the live demo - the public RPC rate limits.
MONAD_RPC=https://testnet-rpc.monad.xyz

# Price of one pack, in MON.
PACK_PRICE=0.001

# Burner wallets pre-generated for the room.
POOL_SIZE=120
# MON funded into each burner. 0.05 covers about 5 rips including gas headroom.
POOL_FUNDING=0.05

# Bot swarm: how many wallets from the END of the pool act as bots.
BOTS=12

# --- hosted server only (Railway); not needed for local dev ---
# The burner pool, base64 of wallets.json. The file itself is gitignored and
# never reaches a host; this is how the server gets it instead.
#   node -e "console.log(Buffer.from(require('fs').readFileSync('wallets.json')).toString('base64'))"
# WALLETS_B64=

# Only when the page calls the server cross-origin instead of being proxied
# to it. Explicit allowlist, comma separated - /api/claim hands out keys.
# ALLOWED_ORIGIN=https://your-app.vercel.app
